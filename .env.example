# 使用说明见 USAGE.md；仓库总览见 README.md
# 从 Google AI Studio 申请 Key：https://aistudio.google.com/apikey

GEMINI_API_KEY=你的key

# 免费额度紧时优先用 lite 系，避免 429
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=45000

# 国内访问 Google 如需本地代理：
# HTTPS_PROXY=http://127.0.0.1:7890

# 默认工作视频（仓库自带 samples/demo.mp4；也可改成你的路径）
DEFAULT_VIDEO=samples/demo.mp4

# 可选：指定中文字体文件（一般不用填，Windows 会自动找微软雅黑）
# VIDEO_FONT=C:\Windows\Fonts\msyh.ttc

# Web UI（python web_app.py）
# WEB_HOST=127.0.0.1
# WEB_PORT=7860
# WEB_MAX_UPLOAD_MB=100
# WEB_MODE 由 web_app 自动设为 1，一般不用手填
