# 使用说明 USAGE.md｜排障 PROBLEMS.md｜交接 HANDOFF.md｜总览 README.md
# 从 Google AI Studio 申请 Key：https://aistudio.google.com/apikey
# 国内：浏览器开 VPN 往往不够，请同时配置下方 HTTPS_PROXY 或开系统/TUN 代理

GEMINI_API_KEY=你的key

# 免费额度紧时优先用 lite 系，避免 429
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=45000

# 国内访问 Google：仅浏览器开 VPN 经常不够，Python 也要走代理。
# Clash / V2Ray 常见本地端口（按你的软件改）：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 默认工作视频（仓库自带 samples/demo.mp4；也可改成你的路径）
DEFAULT_VIDEO=samples/demo.mp4

# 可选：指定中文字体文件（一般不用填，Windows 会自动找微软雅黑）
# VIDEO_FONT=C:\Windows\Fonts\msyh.ttc

# Web UI（python web_app.py）
# WEB_HOST=127.0.0.1
# WEB_PORT=7860
# WEB_MAX_UPLOAD_MB=100
# WEB_MODE 由 web_app 自动设为 1，一般不用手填
