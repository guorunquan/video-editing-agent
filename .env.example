# 从 mini-tool-agent / 笔记 Agent 复制 Key 后确认：

GEMINI_API_KEY=你的key

# 免费额度紧时优先用 lite 系，避免 429
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=45000

# 国内访问 Google 如需本地代理：
# HTTPS_PROXY=http://127.0.0.1:7890

# 默认工作视频（放入 samples/ 后改文件名，或填绝对路径）
DEFAULT_VIDEO=samples/demo.mp4

# 可选：指定中文字体文件（一般不用填，Windows 会自动找微软雅黑）
# VIDEO_FONT=C:\Windows\Fonts\msyh.ttc
